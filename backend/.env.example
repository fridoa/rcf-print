# === Environment ===
# Pilihan: development | autotest | test | staging | production
APP_ENV=development
NODE_ENV=development
PORT=3000

# === Database ===
# WAJIB menyebut nama database sebelum tanda '?'.
# Nama database harus cocok dengan APP_ENV:
#   development → *_dev        staging    → *_staging
#   autotest    → *_autotest   production → tanpa suffix
#   test        → *_test  (QA manual, bukan npm test)
DATABASE_URL=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/rcf_print_dev?retryWrites=true&w=majority&appName=Cluster0

# === JWT ===
JWT_SECRET_KEY=ganti_dengan_string_acak_panjang
JWT_EXPIRES_IN=1d

# === SMTP (Gmail: butuh 2FA aktif + App Password 16 karakter) ===
EMAIL_SMTP_SERVICE_NAME=gmail
EMAIL_SMTP_USER=akunkamu@gmail.com
EMAIL_SMTP_PASS=xxxxxxxxxxxxxxxx
EMAIL_SMTP_FROM_NAME=RCF Print

# === CORS ===
# FRONTEND_URL di bawah otomatis diizinkan. Isi ini hanya untuk origin
# TAMBAHAN, dipisah koma. Contoh:
#   CORS_ORIGINS=https://www.rcfprint.com,https://admin.rcfprint.com
# Di development/autotest, localhost port berapa pun sudah diizinkan.
CORS_ORIGINS=

# === Frontend (untuk link reset password di email) ===
FRONTEND_URL=http://localhost:5173

# === OTP & Reset Password ===
OTP_EXPIRES_MINUTES=10
RESET_TOKEN_EXPIRES_MINUTES=60

# === ImageKit (penyimpanan file desain) ===
# Ambil dari dashboard ImageKit → Developer → API Keys.
# Kalau kosong, seluruh API tetap jalan; hanya fitur upload/galeri desain
# yang mati (endpoint upload akan menolak dengan 503).
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/idkamu
# Folder root tempat semua desain disimpan (opsional).
IMAGEKIT_FOLDER=/rcf-print/designs

# Batas ukuran satu file desain dalam byte (opsional, default 10 MB).
DESIGN_MAX_FILE_BYTES=10485760
