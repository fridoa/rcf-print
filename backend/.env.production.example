# Dipakai docker-compose.prod.yml (env_file: ./backend/.env.production)
# Salin ke .env.production dan isi nilai sebenarnya.

APP_ENV=production
NODE_ENV=production
PORT=3000

# WAJIB tanpa suffix _dev/_test/_autotest/_staging.
# env.js menolak start kalau APP_ENV=production tapi nama database
# berakhiran salah satu suffix itu.
DATABASE_URL=mongodb+srv://user:***@cluster0.xxxxx.mongodb.net/rcf_print?retryWrites=true&w=majority&appName=Cluster0

JWT_SECRET_KEY=string_acak_panjang_khusus_production
JWT_EXPIRES_IN=1d

EMAIL_SMTP_SERVICE_NAME=gmail
EMAIL_SMTP_USER=akunkamu@gmail.com
EMAIL_SMTP_PASS=xxxxxxxxxxxxxxxx
EMAIL_SMTP_FROM_NAME=RCF Print

# Alamat publik FE — dipakai untuk link reset password di email DAN
# sebagai origin utama yang diizinkan CORS. Harus sama persis dengan
# alamat yang diketik user di browser (skema + host + port), kalau tidak
# request POST same-origin pun ikut ditolak 403.
FRONTEND_URL=https://rcfprint.example.com

# Origin tambahan, dipisah koma. Kosongkan kalau tidak ada.
CORS_ORIGINS=https://www.rcfprint.example.com

OTP_EXPIRES_MINUTES=10
RESET_TOKEN_EXPIRES_MINUTES=60
